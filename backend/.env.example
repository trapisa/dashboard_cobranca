# Banco de dados PostgreSQL
# Local: postgresql://usuario:senha@localhost:5432/crm_cobranca_trapisa
# Neon (produção gratuita): copie a "Connection string" do painel do Neon
# (algo como postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/crm_cobranca_trapisa?sslmode=require)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/crm_cobranca_trapisa

# Deixe true (padrão) para Neon/Supabase e a maioria dos provedores gratuitos, que exigem SSL.
# Só mude para false em Postgres local sem SSL configurado.
DATABASE_SSL=true

# JWT
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=8h

# Redis (para fila de importação assíncrona - bullmq)
REDIS_URL=redis://localhost:6379

# Servidor
PORT=3001
NODE_ENV=development

# URL(s) do frontend em produção, separadas por vírgula (para restringir o CORS).
# Ex.: https://crm-cobranca-trapisa.pages.dev
# Deixe vazio em desenvolvimento para liberar qualquer origem.
FRONTEND_URL=

# Upload
MAX_UPLOAD_SIZE_MB=25

# Usuário admin inicial (seed)
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@trapisa.com.br
SEED_ADMIN_SENHA=troque_esta_senha
